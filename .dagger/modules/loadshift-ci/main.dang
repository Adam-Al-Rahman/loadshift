"""
Loadshift development and CI environment.

Responsibilities:
- Reproducible Rust builds.
- Formatting and linting.
- Workspace compilation and tests.
- Release compilation.
- Local HTTP API service.
"""

type LoadshiftCi {
  source: Directory!

  new(ws: Workspace!) {
    self.source = ws.directory(
      "/",
      exclude: [
        ".git",
        ".jj",
        ".dagger",
        ".github",
        "target",
        ".env",
        ".env.*",
        ".secrets",
      ],
    )

    self
  }

  """
  Shared Rust build environment.

  All Rust compilation and validation happens inside Dagger.
  Cargo registry, Git dependencies, and build artifacts are cached.
  """
  let rustEnv: Container! {
    container
      .from("rust:1.100-slim-bookworm")

      .withMountedDirectory(
        "/workspace",
        source,
      )

      .withMountedCache(
        "/usr/local/cargo/registry",
        cacheVolume("loadshift-cargo-registry"),
      )

      .withMountedCache(
        "/usr/local/cargo/git",
        cacheVolume("loadshift-cargo-git"),
      )

      .withMountedCache(
        "/workspace/target",
        cacheVolume("loadshift-target"),
      )

      .withWorkdir("/workspace")

      .withEnvVariable(
        "CARGO_TERM_COLOR",
        "always",
      )

      # Install components required by the project.
      .withExec([
        "rustup",
        "component",
        "add",
        "clippy",
        "rustfmt",
      ])
  }

  """
  Check the complete workspace.

  Validates that all workspace targets compile.
  """
  check: Void @check {
    rustEnv
      .withExec([
        "cargo",
        "check",
        "--workspace",
        "--all-targets",
        "--locked",
      ])
      .sync

    null
  }

  """
  Verify Rust formatting across the workspace.
  """
  fmt: Void @check {
    rustEnv
      .withExec([
        "cargo",
        "fmt",
        "--all",
        "--check",
      ])
      .sync

    null
  }

  """
  Run Clippy across the workspace.

  Treat compiler and lint warnings as errors.
  """
  clippy: Void @check {
    rustEnv
      .withExec([
        "cargo",
        "clippy",
        "--workspace",
        "--all-targets",
        "--locked",
        "--",
        "-D",
        "warnings",
      ])
      .sync

    null
  }

  """
  Run the Rust test suite across the workspace.
  """
  test: Void @check {
    rustEnv
      .withExec([
        "cargo",
        "test",
        "--workspace",
        "--all-targets",
        "--locked",
      ])
      .sync

    null
  }

  """
  Build the complete workspace in release mode.
  """
  release: Void @check {
    rustEnv
      .withExec([
        "cargo",
        "build",
        "--workspace",
        "--release",
        "--locked",
      ])
      .sync

    null
  }

  """
  Run the Loadshift HTTP API.

  Exposes the API on port 3000.
  """
  api: Service! {
    rustEnv
      .withExec([
        "cargo",
        "run",
        "--locked",
        "--package",
        "loadshift-api",
      ])
      .withExposedPort(3000)
      .asService
  }
}
